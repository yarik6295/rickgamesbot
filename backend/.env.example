# Telegram Bot Token (для валидации initData WebApp и работы бота)
BOT_TOKEN=123456789:AAExampleTelegramBotTokenHere
# Имя бота без @ — нужно для генерации реферальных deep-link
BOT_USERNAME=your_bot_username

# URL Mini App — используется кнопкой "🎮 Открыть Mini App" в чате бота
# (web_app-кнопка). Должен быть https и совпадать с тем, что указан
# в @BotFather → Bot Settings → Menu Button / Web App.
WEBAPP_URL=https://your-domain.example.com

# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token у вебхука
# (POST /api/user/telegram/webhook). Тот же секрет указывается при вызове
# setWebhook. Необязателен для локальной разработки, но обязателен в проде.
TELEGRAM_WEBHOOK_SECRET=

# Порт сервера
PORT=3000

# --- Turso (SQLite-совместимая БД по сети, вместо локального файла) ---
# Получить: turso db create <имя>, затем turso db show <имя> --url
TURSO_DATABASE_URL=libsql://your-db-name-yourname.turso.io
# Получить: turso db tokens create <имя>
TURSO_AUTH_TOKEN=

# Секрет для подписи внутренних сессий (если используется JWT)
SESSION_SECRET=change_me_super_secret

# Комиссия при продаже предмета обратно в монеты (0.2 = 20%)
SELL_COMMISSION=0.2

# Режим разработки: если true — initData не проверяется строго (для локальных тестов вне Telegram)
DEV_SKIP_TELEGRAM_AUTH=false

# Проект пока поддерживает только один Node-инстанс: Crash и активные раунды
# хранят часть состояния в памяти процесса. Укажите реальное число реплик,
# чтобы сервер предупредил о небезопасной конфигурации.
APP_INSTANCE_COUNT=1
# Если за приложением есть балансировщик, включите предупреждение даже когда
# платформа не передаёт количество реплик через переменные окружения.
LOAD_BALANCER_ENABLED=false

# Сколько секунд считать initData свежей (по умолчанию 24 часа)
INIT_DATA_MAX_AGE_SEC=86400

# Максимум монет за одно пополнение баланса вручную (кнопка "+" у баланса)
MAX_TOPUP_AMOUNT=1000000
